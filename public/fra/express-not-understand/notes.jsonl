{"id": "note_pron_001", "content": "/ʒə nə kɔ̃pʁɑ̃ pa/", "noteType": "ipa"}
{"id": "note_usage_001", "content": "Say you did not understand what was said.", "noteType": "usage"}
{"id": "note_pron_002", "content": "/pu.ve vu ʁepete sil vu plɛ/", "noteType": "ipa"}
{"id": "note_usage_002", "content": "Politely ask someone to repeat themselves.", "noteType": "usage"}
{"id": "note_pron_003", "content": "/paʁle ply lɑ̃tmɑ̃ sil vu plɛ/", "noteType": "ipa"}
{"id": "note_usage_003", "content": "Request that the other person speaks more slowly.", "noteType": "usage"}
