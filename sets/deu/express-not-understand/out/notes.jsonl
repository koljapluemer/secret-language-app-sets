{"id": "note_pron_001", "content": "/ɪç fɛɐˈʃteːə nɪçt/", "noteType": "ipa"}
{"id": "note_usage_001", "content": "Use to signal that you did not understand what was said.", "noteType": "usage"}
{"id": "note_pron_002", "content": "/ˈkœnən zi das ˈbɪtə viːdɐˈhoːlən/", "noteType": "ipa"}
{"id": "note_usage_002", "content": "Politely ask the speaker to repeat their message.", "noteType": "usage"}
{"id": "note_pron_003", "content": "/ˈʃpʁɛçn̩ zi ˈbɪtə laŋˈzaːmɐ/", "noteType": "ipa"}
{"id": "note_usage_003", "content": "Request that the other person speaks more slowly.", "noteType": "usage"}
